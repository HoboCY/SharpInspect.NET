<Window x:Class="SharpInspect.Wpf.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SharpInspect.NET · 工位工作台" Width="1120" Height="900" MinWidth="860" MinHeight="640"
        WindowStartupLocation="CenterScreen" FontFamily="Microsoft YaHei UI" Background="#F3F5F7">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#CAD3DD" />
            <Setter Property="Foreground" Value="#172B42" />
        </Style>
        <DataTemplate x:Key="StateRowTemplate">
            <Grid Margin="0,5">
                <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" Foreground="#556679" FontSize="12" />
                <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="#172B42" TextWrapping="Wrap" FontSize="12" />
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <DockPanel Background="#F3F5F7">
        <Border DockPanel.Dock="Top" Background="#172B42" Padding="26,20">
            <Grid>
                <StackPanel>
                    <TextBlock Text="SharpInspect.NET" Foreground="White" FontWeight="SemiBold" FontSize="26" />
                    <TextBlock Text="工位工作台 · V1 开发宿主" Foreground="#B7C7D8" Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="FreshnessLabel" Foreground="#F4D592" FontSize="16" Text="等待完整状态" HorizontalAlignment="Right" />
                    <TextBlock Text="未完成生产配置与资格" Foreground="#B7C7D8" Margin="0,6,0,0" />
                </StackPanel>
            </Grid>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#DAE1E8" BorderThickness="0,1,0,0" Padding="24,16">
            <StackPanel>
                <WrapPanel Margin="0,0,0,12">
                    <Button Content="请求武装生产" Command="{Binding ArmCommand}" />
                    <Button Content="本机停止" Command="{Binding StopCommand}" Background="#9B3430" Foreground="White" BorderBrush="#9B3430" />
                    <Button Content="遮蔽页面" Click="LockPage" />
                    <Button Content="显示页面" Click="RevealPageClick" />
                </WrapPanel>
                <TextBlock x:Name="OutcomeLabel" Text="命令：尚未提交" TextWrapping="Wrap" Foreground="#334E68" />
                <TextBlock x:Name="ProgressLabel" Text="最终状态：等待关联快照" TextWrapping="Wrap" Foreground="#556679" Margin="0,4,0,0" />
                <TextBlock Text="身份认证尚未交付；显示页面不授予权限。普通关窗仅遮蔽页面，后台 Runtime 持续运行。"
                           Foreground="#6B7888" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <Grid Margin="24,18">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <WrapPanel Margin="0,0,0,14">
                        <Button Content="生产" Command="{Binding NavigateCommand}" CommandParameter="Production" />
                        <Button Content="报警" Command="{Binding NavigateCommand}" CommandParameter="Alarms" />
                        <Button Content="配方" Command="{Binding NavigateCommand}" CommandParameter="Recipes" />
                        <Button Content="手动 / 预览 / 标定" Command="{Binding NavigateCommand}" CommandParameter="Engineering" />
                        <Button Content="资格" Command="{Binding NavigateCommand}" CommandParameter="Qualification" />
                        <Button Content="追溯" Command="{Binding NavigateCommand}" CommandParameter="Trace" />
                        <Button Content="维护 / 管理" Command="{Binding NavigateCommand}" CommandParameter="Maintenance" />
                    </WrapPanel>
                    <TextBlock x:Name="SectionLabel" Text="生产 · 当前完整状态" Foreground="#172B42" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Background="White" BorderBrush="#DAE1E8" BorderThickness="1" Padding="18">
                            <StackPanel>
                                <TextBlock Text="运行与控制" FontSize="15" FontWeight="SemiBold" Foreground="#172B42" Margin="0,0,0,10" />
                                <ItemsControl x:Name="RuntimeRows" ItemTemplate="{StaticResource StateRowTemplate}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="White" BorderBrush="#DAE1E8" BorderThickness="1" Padding="18">
                            <StackPanel>
                                <TextBlock Text="设备、证据与资格" FontSize="15" FontWeight="SemiBold" Foreground="#172B42" Margin="0,0,0,10" />
                                <ItemsControl x:Name="SubsystemRows" ItemTemplate="{StaticResource StateRowTemplate}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Border Background="#FFF7E7" BorderBrush="#E4CE9F" BorderThickness="1" Padding="18" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="当前生产阻塞原因" Foreground="#75531A" FontWeight="SemiBold" />
                            <TextBlock x:Name="BlockersLabel" Text="尚未收到完整快照" Foreground="#75531A" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <Border x:Name="PrivacyCover" Visibility="Collapsed" Background="#F3F5F7">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="页面已遮蔽" FontSize="28" Foreground="#172B42" HorizontalAlignment="Center" />
                    <TextBlock Text="后台工位持续运行。本机停止入口仍可使用。" Foreground="#556679" Margin="0,16,0,0" />
                    <TextBlock Text="点击下方“显示页面”恢复查看。" Foreground="#556679" Margin="0,8,0,0" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
