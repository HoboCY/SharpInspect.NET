<Window x:Class="SharpInspect.Wpf.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SharpInspect.Wpf"
        Title="SharpInspect.NET · 工位工作台" Width="1120" Height="900" MinWidth="860" MinHeight="640"
        WindowStartupLocation="CenterScreen" FontFamily="Microsoft YaHei UI" Background="#F3F5F7">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#CAD3DD" />
            <Setter Property="Foreground" Value="#172B42" />
        </Style>
        <DataTemplate x:Key="StateRowTemplate">
            <Grid Margin="0,5">
                <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" Foreground="#556679" FontSize="12" />
                <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="#172B42" TextWrapping="Wrap" FontSize="12" />
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <DockPanel Background="#F3F5F7">
        <Border DockPanel.Dock="Top" Background="#172B42" Padding="26,20">
            <Grid>
                <StackPanel>
                    <TextBlock Text="SharpInspect.NET" Foreground="White" FontWeight="SemiBold" FontSize="26" />
                    <TextBlock Text="工位工作台 · V1 开发宿主" Foreground="#B7C7D8" Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="FreshnessLabel" Foreground="#F4D592" FontSize="16" Text="等待完整状态" HorizontalAlignment="Right" />
                    <TextBlock Text="未完成生产配置与资格" Foreground="#B7C7D8" Margin="0,6,0,0" />
                </StackPanel>
            </Grid>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#DAE1E8" BorderThickness="0,1,0,0" Padding="24,16">
            <StackPanel>
                <WrapPanel Margin="0,0,0,12">
                    <Button Content="请求武装生产" Command="{Binding ArmCommand}" />
                    <Button Content="本机停止" Command="{Binding StopCommand}" Background="#9B3430" Foreground="White" BorderBrush="#9B3430" />
                    <Button Content="遮蔽页面" Click="LockPage" />
                    <Button Content="显示页面" Click="RevealPageClick" />
                    <Button Content="退出登录" Click="LogoutClick" />
                </WrapPanel>
                <TextBlock x:Name="OutcomeLabel" Text="命令：尚未提交" TextWrapping="Wrap" Foreground="#334E68" />
                <TextBlock x:Name="ProgressLabel" Text="最终状态：等待关联快照" TextWrapping="Wrap" Foreground="#556679" Margin="0,4,0,0" />
                <TextBlock Text="登录不会自动武装生产。退出、空闲锁定和普通关窗保持后台运行。"
                           Foreground="#6B7888" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <Grid Margin="24,18">
            <ScrollViewer x:Name="MainScrollViewer" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <WrapPanel Margin="0,0,0,14">
                        <Button Content="生产" Command="{Binding NavigateCommand}" CommandParameter="Production" />
                        <Button Content="报警" Command="{Binding NavigateCommand}" CommandParameter="Alarms" />
                        <Button Content="配方" Command="{Binding NavigateCommand}" CommandParameter="Recipes" />
                        <Button Content="手动 / 预览 / 标定" Command="{Binding NavigateCommand}" CommandParameter="Engineering" />
                        <Button Content="资格" Command="{Binding NavigateCommand}" CommandParameter="Qualification" />
                        <Button Content="追溯" Command="{Binding NavigateCommand}" CommandParameter="Trace" />
                        <Button Content="维护 / 管理" Command="{Binding NavigateCommand}" CommandParameter="Maintenance" />
                    </WrapPanel>
                    <TextBlock x:Name="SectionLabel" Text="生产 · 当前完整状态" Foreground="#172B42" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <Grid x:Name="SnapshotPanel">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Background="White" BorderBrush="#DAE1E8" BorderThickness="1" Padding="18">
                            <StackPanel>
                                <TextBlock Text="运行与控制" FontSize="15" FontWeight="SemiBold" Foreground="#172B42" Margin="0,0,0,10" />
                                <ItemsControl x:Name="RuntimeRows" ItemTemplate="{StaticResource StateRowTemplate}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="White" BorderBrush="#DAE1E8" BorderThickness="1" Padding="18">
                            <StackPanel>
                                <TextBlock Text="设备、证据与资格" FontSize="15" FontWeight="SemiBold" Foreground="#172B42" Margin="0,0,0,10" />
                                <ItemsControl x:Name="SubsystemRows" ItemTemplate="{StaticResource StateRowTemplate}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Border x:Name="BlockersPanel" Background="#FFF7E7" BorderBrush="#E4CE9F" BorderThickness="1" Padding="18" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="当前生产阻塞原因" Foreground="#75531A" FontWeight="SemiBold" />
                            <TextBlock x:Name="BlockersLabel" Text="尚未收到完整快照" Foreground="#75531A" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <local:AlarmPanel x:Name="AlarmPanel" Visibility="Collapsed" Margin="0,16,0,0" />
                    <Border x:Name="TracePanel" Visibility="Collapsed" Background="White" BorderBrush="#DAE1E8" BorderThickness="1" Padding="18" Margin="0,16,0,0">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel x:Name="TraceUnavailablePanel" Grid.Row="1">
                                <TextBlock Text="命令追溯" Foreground="#172B42" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="追溯不可用：未配置只读查询服务。" Foreground="#75531A" Margin="0,10,0,0" TextWrapping="Wrap" />
                                <TextBlock Text="配置追溯数据源后可在这里查看命令记录。" Foreground="#6B7888" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <Border x:Name="IntegrityPanel" Background="#F8FAFC" BorderBrush="#DAE1E8" BorderThickness="1" Padding="14" Margin="0,14,0,14">
                                <StackPanel>
                                    <TextBlock Text="审计完整性 · 只读有界验证" Foreground="#172B42" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="当前为有界、只读验证；部分验证不授予 Ready。" Foreground="#75531A" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" />
                                    <StackPanel x:Name="IntegrityUnavailablePanel">
                                        <TextBlock Text="审计完整性不可用：未配置只读查询服务。" Foreground="#75531A" Margin="0,8,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel x:Name="IntegrityAvailablePanel" Visibility="Collapsed">
                                        <WrapPanel Margin="0,10,0,8">
                                            <Button Content="刷新验证" Command="{Binding RefreshCommand}" />
                                            <Button Content="继续验证下一段" Command="{Binding NextSegmentCommand}" />
                                        </WrapPanel>
                                        <TextBlock Text="{Binding StateLabel, Mode=OneWay}" Foreground="#334E68" />
                                        <TextBlock Text="{Binding StatusMessage, Mode=OneWay}" Foreground="#334E68" Margin="0,4,0,0" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding SummaryText, Mode=OneWay}" Foreground="#556679" Margin="0,4,0,0" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding ErrorMessage, Mode=OneWay}" Foreground="#9B3430" Margin="0,4,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <StackPanel x:Name="TraceAvailablePanel" Grid.Row="1" Visibility="Collapsed">
                                <TextBlock Text="命令追溯 · 只读事实" Foreground="#172B42" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="声称主体仅是输入归因，未经认证；Accepted 只表示 Runtime 受理，不表示操作完成。"
                                           Foreground="#6B7888" FontSize="11" Margin="0,6,0,12" TextWrapping="Wrap" />
                                <WrapPanel Margin="0,0,0,8">
                                    <TextBlock Text="相关 CorrelationId" VerticalAlignment="Center" Foreground="#556679" Margin="0,0,8,0" />
                                    <TextBox Width="250" Margin="0,0,14,0" Text="{Binding CorrelationIdText, UpdateSourceTrigger=PropertyChanged}" ToolTip="可选 GUID；留空表示全部" />
                                    <TextBlock Text="声称主体" VerticalAlignment="Center" Foreground="#556679" Margin="0,0,8,0" />
                                    <TextBox Width="190" Margin="0,0,14,0" Text="{Binding ClaimedPrincipalIdText, UpdateSourceTrigger=PropertyChanged}" ToolTip="未经认证的输入归因" />
                                    <Button Content="刷新" Command="{Binding RefreshCommand}" />
                                    <Button Content="上一页" Command="{Binding PreviousPageCommand}" />
                                    <Button Content="下一页" Command="{Binding NextPageCommand}" />
                                </WrapPanel>
                                <TextBlock Text="{Binding StatusMessage}" Foreground="#334E68" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ErrorMessage}" Foreground="#9B3430" TextWrapping="Wrap" Margin="0,4,0,0" />
                                <TextBlock Foreground="#556679" Margin="0,4,0,10" TextWrapping="Wrap">
                                    <Run Text="当前页：" />
                                    <Run Text="{Binding CurrentPage, Mode=OneWay}" />
                                    <Run Text=" · 快照上界：" />
                                    <Run Text="{Binding ThroughPosition, Mode=OneWay, TargetNullValue=未建立}" />
                                    <Run Text=" · 正在读取：" />
                                    <Run Text="{Binding IsBusy, Mode=OneWay}" />
                                </TextBlock>
                                <DataGrid x:Name="TraceGrid" ItemsSource="{Binding Rows}" IsReadOnly="True" AutoGenerateColumns="False"
                                          Height="380" MinHeight="220" CanUserAddRows="False" CanUserDeleteRows="False"
                                          EnableRowVirtualization="True" EnableColumnVirtualization="True"
                                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                          ScrollViewer.CanContentScroll="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="序号" Binding="{Binding Position}" Width="50" />
                                        <DataGridTextColumn Header="发生时间 UTC" Binding="{Binding OccurredAtUtc, StringFormat={}{0:yyyy-MM-dd HH:mm:ss.fff}}" Width="155" />
                                        <DataGridTextColumn Header="命令" Binding="{Binding CommandKind}" Width="145" />
                                        <DataGridTextColumn Header="阶段" Binding="{Binding Phase}" Width="90" />
                                        <DataGridTextColumn Header="受理结果" Binding="{Binding Disposition}" Width="90" />
                                        <DataGridTextColumn Header="原因码" Binding="{Binding ReasonCode}" Width="180" />
                                        <DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="115" />
                                        <DataGridTextColumn Header="声称主体（未认证）" Binding="{Binding ClaimedPrincipalId}" Width="170" />
                                        <DataGridTextColumn Header="系统记录者" Binding="{Binding SystemPrincipalId}" Width="170" />
                                        <DataGridTextColumn Header="认证人员" Binding="{Binding AuthenticatedHumanPrincipalId}" Width="100" />
                                        <DataGridTextColumn Header="CorrelationId" Binding="{Binding CorrelationId}" Width="230" />
                                        <DataGridTextColumn Header="AttemptId" Binding="{Binding AttemptId}" Width="230" />
                                        <DataGridTextColumn Header="EventId" Binding="{Binding EventId}" Width="230" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <local:AlgorithmResultPanel x:Name="AlgorithmResultsPanel" Visibility="Collapsed" Margin="0,16,0,0" />
                    <local:IdentityPanel x:Name="IdentityPanel" Visibility="Collapsed" Margin="0,16,0,0" />
                    <local:IdentityAdministrationPanel x:Name="IdentityAdministrationPanel" Visibility="Collapsed" Margin="0,16,0,0" />
                    <local:AdministratorRecoveryPanel x:Name="AdministratorRecoveryPanel" Visibility="Collapsed" Margin="0,16,0,0" />
                </StackPanel>
            </ScrollViewer>
            <Border x:Name="PrivacyCover" Visibility="Collapsed" Background="#F3F5F7">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="页面已遮蔽" FontSize="28" Foreground="#172B42" HorizontalAlignment="Center" />
                    <TextBlock Text="后台工位持续运行。本机停止入口仍可使用。" Foreground="#556679" Margin="0,16,0,0" />
                    <TextBlock x:Name="PrivacyInstruction" Text="点击下方“显示页面”恢复查看。" Foreground="#556679" Margin="0,8,0,0" HorizontalAlignment="Center" />
                    <Button x:Name="OpenAdministratorRecoveryButton" Content="进入本机管理员恢复"
                            Click="OpenAdministratorRecoveryClick" Margin="0,18,0,0" />
                    <TextBlock x:Name="PrivacyRecoveryStatus" TextWrapping="Wrap" Foreground="#75531A"
                               Margin="0,8,0,0" HorizontalAlignment="Center" />
                    <Button x:Name="ReturnToLockedLoginButton" Content="返回正常登录"
                            Click="ReturnToLockedLoginClick" Visibility="Collapsed" Margin="0,10,0,0" />
                    <StackPanel x:Name="LockedLoginPanel" Visibility="Collapsed" Margin="0,24,0,0" Width="380">
                        <TextBlock Text="用户名" Foreground="#556679" />
                        <TextBox x:Name="LockedUserNameBox" Margin="0,6,0,14" />
                        <TextBlock Text="密码" Foreground="#556679" />
                        <PasswordBox x:Name="LockedPasswordBox" Margin="0,6,0,14" />
                        <Button x:Name="LockedSignInButton" Content="登录并解锁" Click="LockedSignInClick" />
                        <TextBlock x:Name="LockedSignInStatus" TextWrapping="Wrap" Foreground="#556679" Margin="0,14,0,0" />
                    </StackPanel>
                    <local:AdministratorRecoveryPanel x:Name="PrivacyAdministratorRecoveryPanel"
                                                       Visibility="Collapsed" Width="720" MaxHeight="620"
                                                       Margin="0,18,0,0" />
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
