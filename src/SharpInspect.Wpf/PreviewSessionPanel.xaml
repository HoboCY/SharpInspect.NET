<UserControl x:Class="SharpInspect.Wpf.PreviewSessionPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             FontFamily="Microsoft YaHei UI">
    <Border Background="White" BorderBrush="#DAE1E8" BorderThickness="1" Padding="18">
        <ScrollViewer x:Name="PreviewScrollViewer" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Grid>
                    <StackPanel>
                        <TextBlock Text="手动预览会话" Foreground="#172B42" FontSize="18"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Preview 只读取独立图像副本；进入、调参、冻结、保存和退出都必须由操作者显式提交。"
                                   Foreground="#6B7888" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top">
                        <TextBlock x:Name="StatusLabel" Text="未登录" Foreground="#75531A"
                                   HorizontalAlignment="Right" />
                        <TextBlock Text="Ready=false · 页面关闭不会自动退出 Runtime 会话"
                                   Foreground="#75531A" FontSize="11" Margin="0,4,0,0"
                                   TextWrapping="Wrap" HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>

                <StackPanel x:Name="UnavailablePanel" Margin="0,14,0,0">
                    <Border Background="#FFF7E7" BorderBrush="#E4CE9F" BorderThickness="1" Padding="12">
                        <StackPanel>
                            <TextBlock Text="Preview 查询/命令边界不可用" Foreground="#75531A"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="UnavailableText" TextWrapping="Wrap" Foreground="#75531A"
                                       Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="ConfiguredPanel" Visibility="Collapsed">
                    <Border Background="#F8FAFC" BorderBrush="#DAE1E8" BorderThickness="1"
                            Padding="12" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="Runtime 读回" Foreground="#172B42" FontSize="14"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="StatusText" Text="等待刷新" Foreground="#334E68"
                                       TextWrapping="Wrap" Margin="0,6,0,0" />
                            <TextBlock Text="{Binding PhaseSummary}" Foreground="#556679"
                                       TextWrapping="Wrap" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding RestorationSummary}" Foreground="#556679"
                                       TextWrapping="Wrap" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding LastCommandSummary}" Foreground="#556679"
                                       TextWrapping="Wrap" Margin="0,4,0,0" />
                            <TextBlock x:Name="ErrorText" Foreground="#9B3430" TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                            <TextBlock Text="{Binding ValidationSummary}" Foreground="#75531A"
                                       FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Background="#F8FAFC" BorderBrush="#DAE1E8" BorderThickness="1"
                            Padding="12" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="明确 Draft 与活动基线" Foreground="#172B42" FontSize="14"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="进入 Preview 使用宿主提供的精确 Draft 修订和可选 ExpectedActive；页面不会从文本猜测或构造它们。"
                                       Foreground="#6B7888" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="125" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="DraftId" Foreground="#556679" Margin="0,2" />
                                <TextBlock Grid.Column="1" Text="{Binding Draft.DraftId, StringFormat={}{0:D}}"
                                           Foreground="#172B42" TextWrapping="Wrap" Margin="0,2" />
                                <TextBlock Grid.Row="1" Text="Revision" Foreground="#556679" Margin="0,2" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Draft.Revision}"
                                           Foreground="#172B42" Margin="0,2" />
                                <TextBlock Grid.Row="2" Text="DraftHash" Foreground="#556679" Margin="0,2" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Draft.RevisionContentHash}"
                                           Foreground="#172B42" TextWrapping="Wrap" Margin="0,2" />
                                <TextBlock Grid.Row="3" Text="Active.Position" Foreground="#556679" Margin="0,2" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ExpectedActive.Position}"
                                           Foreground="#172B42" Margin="0,2" />
                                <TextBlock Grid.Row="4" Text="Active.ActivationId" Foreground="#556679" Margin="0,2" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ExpectedActive.ActivationId, StringFormat={}{0:D}}"
                                           Foreground="#172B42" Margin="0,2" />
                                <TextBlock Grid.Row="5" Text="ActiveHash" Foreground="#556679" Margin="0,2" />
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding ExpectedActive.ContentHash, TargetNullValue=无}"
                                           Foreground="#172B42" TextWrapping="Wrap" Margin="0,2" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Background="#F8FAFC" BorderBrush="#DAE1E8" BorderThickness="1"
                            Padding="12" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="显式 Preview 命令" Foreground="#172B42" FontSize="14"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="调参配置由宿主通过 PreviewTuningConfiguration 提供；按钮只提交 Runtime 命令，不直接操作相机。"
                                       Foreground="#6B7888" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,8" />
                            <WrapPanel>
                                <Button x:Name="RefreshButton" Content="刷新状态" Click="RefreshClick"
                                        Padding="10,4" AutomationProperties.Name="刷新 Preview 状态" />
                                <Button x:Name="StartButton" Content="显式进入" Click="StartClick"
                                        Padding="10,4" AutomationProperties.Name="提交进入 Preview 会话命令" />
                                <Button x:Name="TuneButton" Content="应用调参" Click="TuneClick"
                                        Padding="10,4" AutomationProperties.Name="提交 Preview 调参命令" />
                                <Button x:Name="FreezeButton" Content="冻结固定值" Click="FreezeClick"
                                        Padding="10,4" AutomationProperties.Name="提交冻结 Preview 设置命令" />
                                <Button x:Name="SaveButton" Content="保存到 Draft" Click="SaveClick"
                                        Padding="10,4" AutomationProperties.Name="提交保存 Preview 设置到 Draft 命令" />
                                <Button x:Name="ExitButton" Content="显式退出" Click="ExitClick"
                                        Padding="10,4" AutomationProperties.Name="提交退出 Preview 会话命令" />
                                <Button x:Name="CancelButton" Content="取消当前请求" Click="CancelClick"
                                        Padding="10,4" AutomationProperties.Name="取消当前 Preview 页面请求" />
                            </WrapPanel>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="125" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="进入理由" Foreground="#556679" VerticalAlignment="Center" Margin="0,3" />
                                <TextBox x:Name="StartReasonBox" Grid.Column="1"
                                         Text="{Binding StartReason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="512" Margin="0,3" AutomationProperties.Name="进入 Preview 理由" />
                                <TextBlock Grid.Row="1" Text="调参理由" Foreground="#556679" VerticalAlignment="Center" Margin="0,3" />
                                <TextBox x:Name="TuningReasonBox" Grid.Row="1" Grid.Column="1"
                                         Text="{Binding TuningReason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="512" Margin="0,3" AutomationProperties.Name="Preview 调参理由" />
                                <TextBlock Grid.Row="2" Text="冻结理由" Foreground="#556679" VerticalAlignment="Center" Margin="0,3" />
                                <TextBox x:Name="FreezeReasonBox" Grid.Row="2" Grid.Column="1"
                                         Text="{Binding FreezeReason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="512" Margin="0,3" AutomationProperties.Name="Preview 冻结理由" />
                                <TextBlock Grid.Row="3" Text="保存理由" Foreground="#556679" VerticalAlignment="Center" Margin="0,3" />
                                <TextBox x:Name="SaveReasonBox" Grid.Row="3" Grid.Column="1"
                                         Text="{Binding SaveReason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="512" Margin="0,3" AutomationProperties.Name="Preview 保存理由" />
                                <TextBlock Grid.Row="4" Text="退出理由" Foreground="#556679" VerticalAlignment="Center" Margin="0,3" />
                                <TextBox x:Name="ExitReasonBox" Grid.Row="4" Grid.Column="1"
                                         Text="{Binding ExitReason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="512" Margin="0,3" AutomationProperties.Name="退出 Preview 理由" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Background="#101820" BorderBrush="#DAE1E8" BorderThickness="1"
                            Padding="5" Margin="0,12,0,0">
                        <Image x:Name="PreviewImage" Source="{Binding LatestImage.BitmapSource}"
                               Stretch="Uniform" MaxHeight="420" MinHeight="120"
                               AutomationProperties.Name="Preview 最新图像副本" />
                    </Border>

                    <Border Background="#F8FAFC" BorderBrush="#DAE1E8" BorderThickness="1"
                            Padding="12" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="当前设置与恢复状态（只读）" Foreground="#172B42" FontSize="14"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Snapshot.Configuration.ContentHash, TargetNullValue=尚未读回}"
                                       Foreground="#334E68" TextWrapping="Wrap" Margin="0,6,0,0" />
                            <TextBlock Text="{Binding Snapshot.FrozenSettingsContentHash, TargetNullValue=尚未冻结}"
                                       Foreground="#334E68" TextWrapping="Wrap" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding Snapshot.LatestFrame.Sequence, StringFormat='FrameSequence={0}'}"
                                       Foreground="#556679" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding Snapshot.LatestFrame.PixelFormat, StringFormat='PixelFormat={0}'}"
                                       Foreground="#556679" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
