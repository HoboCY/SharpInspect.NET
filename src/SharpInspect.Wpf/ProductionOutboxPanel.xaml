<UserControl x:Class="SharpInspect.Wpf.ProductionOutboxPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="White" BorderBrush="#DAE1E8" BorderThickness="1" Padding="18">
        <StackPanel>
            <TextBlock Text="外部交付" Foreground="#172B42" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="查看待处理报文、失败分类和历次尝试。" Foreground="#556679" Margin="0,6,0,12" />
            <WrapPanel>
                <Button Content="刷新待处理交付" Command="{Binding RefreshCommand}" Padding="12,6" Margin="0,0,8,0" />
                <Button Content="下一页" Command="{Binding NextPageCommand}" Padding="12,6" />
            </WrapPanel>
            <TextBlock Text="{Binding StatusMessage}" Foreground="#556679" TextWrapping="Wrap" Margin="0,10" />
            <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                      IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      SelectionMode="Single" MinHeight="80" MaxHeight="220" EnableRowVirtualization="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="交付 ID" Binding="{Binding Delivery.DeliveryId}" Width="*" />
                    <DataGridTextColumn Header="路由" Binding="{Binding Delivery.Route.RouteId}" Width="100" />
                    <DataGridTextColumn Header="版本" Binding="{Binding Delivery.Route.Version}" Width="70" />
                    <DataGridTextColumn Header="状态" Binding="{Binding State}" Width="80" />
                    <DataGridTextColumn Header="次数" Binding="{Binding AttemptCount}" Width="60" />
                    <DataGridTextColumn Header="最近原因" Binding="{Binding LastFailureReasonCode}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="{Binding SelectionSummary}" Foreground="#334E68" TextWrapping="Wrap" Margin="0,12,0,6" />
            <TextBlock Text="冻结报文 SHA-256" FontWeight="SemiBold" />
            <TextBox Text="{Binding PayloadHash, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" TextWrapping="Wrap"
                     Foreground="#334E68" Margin="0,4,0,12" />
            <Expander Header="人工处置" Margin="0,0,0,14">
                <StackPanel Margin="0,10,0,0">
                    <TextBlock Text="修复外部依赖后，可授权原报文继续尝试。需要修改内容时，选择最终报文文件创建更正交付；原项继续保留。"
                               TextWrapping="Wrap" Foreground="#556679" Margin="0,0,0,10" />
                    <StackPanel IsEnabled="{Binding CanEditOperations}">
                        <TextBlock Text="处置原因" FontWeight="SemiBold" />
                        <TextBox Text="{Binding ReasonText, UpdateSourceTrigger=PropertyChanged}" MaxLength="256" Margin="0,4,0,10" />
                        <WrapPanel Margin="0,0,0,10">
                            <TextBlock Text="新增尝试次数" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Text="{Binding AttemptsText, UpdateSourceTrigger=PropertyChanged}" Width="45" MaxLength="2" />
                            <TextBlock Text="单次最多 16 次，仍受工位策略和容量限制" VerticalAlignment="Center" Foreground="#556679" Margin="8,0,0,0" />
                        </WrapPanel>
                        <WrapPanel Margin="0,0,0,8">
                            <Button Content="选择更正报文文件" Click="SelectCorrectionClick" Padding="12,6" Margin="0,0,8,0" />
                            <TextBlock Text="内容类型" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Text="{Binding ContentTypeText, UpdateSourceTrigger=PropertyChanged}" Width="200" MaxLength="128" />
                        </WrapPanel>
                        <TextBlock Text="{Binding CorrectionPayloadSummary}" TextWrapping="Wrap" Foreground="#556679" Margin="0,0,0,10" />
                        <TextBlock x:Name="FileStatusText" TextWrapping="Wrap" Foreground="#8B342E" Margin="0,0,0,8" />
                        <TextBlock Text="当前个人账号密码（本次 Step-Up）" FontWeight="SemiBold" />
                        <PasswordBox x:Name="StepUpPasswordBox" MaxLength="1024" Margin="0,4,0,10" />
                    </StackPanel>
                    <WrapPanel>
                        <Button Content="授权原报文继续尝试" IsEnabled="{Binding CanRecover}" Click="RecoverClick" Padding="12,6" Margin="0,0,8,0" />
                        <Button Content="创建关联的更正交付" IsEnabled="{Binding CanCorrect}" Click="CorrectClick" Padding="12,6" />
                    </WrapPanel>
                </StackPanel>
            </Expander>
            <WrapPanel Margin="0,0,0,10">
                <TextBlock Text="历史交付 ID" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Text="{Binding HistoryDeliveryText, UpdateSourceTrigger=PropertyChanged}" MaxLength="64"
                         Width="290" Margin="0,0,8,0" ToolTip="可直接查询已送达或已处置交付的历史。" />
                <Button Content="读取尝试历史" Command="{Binding ReadHistoryCommand}" Padding="12,6" Margin="0,0,8,0" />
                <Button Content="历史下一页" Command="{Binding NextHistoryPageCommand}" Padding="12,6" />
            </WrapPanel>
            <DataGrid ItemsSource="{Binding Events}" IsReadOnly="True" AutoGenerateColumns="False"
                      CanUserAddRows="False" CanUserDeleteRows="False" MinHeight="60" MaxHeight="180"
                      EnableRowVirtualization="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="时间" Binding="{Binding RecordedAtUtc}" Width="*" />
                    <DataGridTextColumn Header="事件" Binding="{Binding Kind}" Width="120" />
                    <DataGridTextColumn Header="失败分类" Binding="{Binding FailureCategory}" Width="120" />
                    <DataGridTextColumn Header="原因" Binding="{Binding ReasonCode}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="人工恢复记录" FontWeight="SemiBold" Margin="0,12,0,6" />
            <DataGrid ItemsSource="{Binding Recoveries}" IsReadOnly="True" AutoGenerateColumns="False"
                      CanUserAddRows="False" CanUserDeleteRows="False" MinHeight="45" MaxHeight="140">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="时间" Binding="{Binding RecordedAtUtc}" Width="*" />
                    <DataGridTextColumn Header="新增次数" Binding="{Binding GrantedAttempts}" Width="80" />
                    <DataGridTextColumn Header="操作人" Binding="{Binding ActorPrincipalId}" Width="*" />
                    <DataGridTextColumn Header="原因" Binding="{Binding Reason}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="更正交付关联" FontWeight="SemiBold" Margin="0,12,0,6" />
            <DataGrid ItemsSource="{Binding Corrections}" IsReadOnly="True" AutoGenerateColumns="False"
                      CanUserAddRows="False" CanUserDeleteRows="False" MinHeight="45" MaxHeight="140">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="原交付 ID" Binding="{Binding SourceDeliveryId}" Width="*" />
                    <DataGridTextColumn Header="更正交付 ID" Binding="{Binding DeliveryId}" Width="*" />
                    <DataGridTextColumn Header="原因" Binding="{Binding Reason}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </Border>
</UserControl>
