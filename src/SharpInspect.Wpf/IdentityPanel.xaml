<UserControl x:Class="SharpInspect.Wpf.IdentityPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="420">
    <Border Background="White" BorderBrush="#DAE1E8" BorderThickness="1" Padding="18">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="维护 / 管理 · 身份引导与登录" Foreground="#172B42" FontSize="15" FontWeight="SemiBold" />

                <StackPanel x:Name="UnavailablePanel" Margin="0,14,0,0">
                    <TextBlock Text="身份服务不可用：未配置身份引导或登录服务。" Foreground="#75531A" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel x:Name="AvailablePanel" Visibility="Collapsed" Margin="0,14,0,0">
                    <WrapPanel Margin="0,0,0,8">
                        <TextBlock Text="状态：" Foreground="#556679" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StatusLabel, Mode=OneWay}" Foreground="#334E68" VerticalAlignment="Center" />
                        <Button Content="刷新状态" Command="{Binding RefreshCommand}" Margin="18,0,0,0" />
                    </WrapPanel>
                    <TextBlock Text="{Binding StatusMessage, Mode=OneWay}" Foreground="#334E68" TextWrapping="Wrap" />
                    <TextBlock Foreground="#556679" Margin="0,4,0,0">
                        <Run Text="可用管理员：" />
                        <Run Text="{Binding UsableAdministratorCount, Mode=OneWay}" />
                        <Run Text=" · 有效恢复码：" />
                        <Run Text="{Binding ValidRecoveryCodeCount, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding ErrorMessage, Mode=OneWay}" Foreground="#9B3430" Margin="0,4,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="操作权限逐次校验，生产准入尚未完成。" Foreground="#6B7888" FontSize="11" Margin="0,6,0,12" TextWrapping="Wrap" />

                    <Border x:Name="BootstrapPanel" Background="#FFF7E7" BorderBrush="#E4CE9F" BorderThickness="1" Padding="14" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="首次管理员" Foreground="#75531A" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="BootstrapToken 由安装流程提供；此页面不会发行或显示新的 BootstrapToken。" Foreground="#75531A" FontSize="11" Margin="0,6,0,10" TextWrapping="Wrap" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="用户名" Foreground="#556679" VerticalAlignment="Center" Margin="0,0,8,8" />
                                <TextBox x:Name="BootstrapUserNameBox" Grid.Column="1" Margin="0,0,0,8" />
                                <TextBlock Text="显示名" Grid.Row="1" Foreground="#556679" VerticalAlignment="Center" Margin="0,0,8,8" />
                                <TextBox x:Name="BootstrapDisplayNameBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" />
                                <TextBlock Text="BootstrapToken" Grid.Row="2" Foreground="#556679" VerticalAlignment="Center" Margin="0,0,8,8" />
                                <PasswordBox x:Name="BootstrapTokenBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" />
                                <TextBlock Text="管理员密码" Grid.Row="3" Foreground="#556679" VerticalAlignment="Center" Margin="0,0,8,8" />
                                <PasswordBox x:Name="BootstrapPasswordBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,8" />
                                <Button x:Name="BootstrapButton" Content="创建首位管理员" Grid.Row="4" Grid.Column="1" HorizontalAlignment="Left" Click="CreateAdministratorClick" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Background="#F8FAFC" BorderBrush="#DAE1E8" BorderThickness="1" Padding="14" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="登录" Foreground="#172B42" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SessionStatus, Mode=OneWay}" Foreground="#556679" Margin="0,6,0,0" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <TextBlock Text="用户名" Foreground="#556679" VerticalAlignment="Center" Margin="0,0,8,8" />
                                <TextBox x:Name="LoginUserNameBox" Grid.Column="1" Margin="0,0,0,8" />
                                <TextBlock Text="密码" Grid.Row="1" Foreground="#556679" VerticalAlignment="Center" Margin="0,0,8,8" />
                                <PasswordBox x:Name="LoginPasswordBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" />
                                <Button x:Name="LoginButton" Content="登录" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" Click="AuthenticateClick" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border x:Name="RecoveryPanel" Background="#EEF6F1" BorderBrush="#B8D8C3" BorderThickness="1" Padding="14" Margin="0,14,0,0" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="恢复包 · 一次领取" Foreground="#275C3B" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="创建成功后只领取一次。请主动显示、保管或复制；完成后立即清除页面内容。" Foreground="#275C3B" FontSize="11" Margin="0,6,0,10" TextWrapping="Wrap" />
                            <WrapPanel>
                                <Button x:Name="RevealRecoveryKitButton" Content="显示恢复包" Click="RevealRecoveryKitClick" />
                                <Button x:Name="CopyRecoveryKitButton" Content="复制并清除" Click="CopyRecoveryKitClick" IsEnabled="False" />
                                <Button x:Name="ClearRecoveryKitButton" Content="清除" Click="ClearRecoveryKitClick" />
                            </WrapPanel>
                            <TextBox x:Name="RecoveryKitDisplayBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" MinHeight="70" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Background="#F8FAFC" BorderBrush="#DAE1E8" BorderThickness="1" Padding="14" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="当前身份显示" Foreground="#172B42" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding IdentitySummary, Mode=OneWay}" Foreground="#334E68" Margin="0,8,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
