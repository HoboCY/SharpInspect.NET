<UserControl x:Class="SharpInspect.Wpf.ManualInspectionSessionPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             FontFamily="Microsoft YaHei UI">
    <Border Background="White" BorderBrush="#DAE1E8" BorderThickness="1" Padding="18">
        <ScrollViewer x:Name="ManualScrollViewer" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Grid>
                    <StackPanel>
                        <TextBlock Text="人工检测会话" Foreground="#172B42" FontSize="18"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="手动检测为非生产流程；Runtime 负责精确配方、会话、运行编号、相机占用和最终状态。"
                                   Foreground="#6B7888" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top">
                        <TextBlock x:Name="StatusLabel" Text="未登录" Foreground="#75531A"
                                   HorizontalAlignment="Right" />
                        <TextBlock Text="Ready=false · 页面打开不会自动开始人工检测"
                                   Foreground="#75531A" FontSize="11" Margin="0,4,0,0"
                                   TextWrapping="Wrap" HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>

                <StackPanel x:Name="UnavailablePanel" Margin="0,14,0,0">
                    <Border Background="#FFF7E7" BorderBrush="#E4CE9F" BorderThickness="1" Padding="12">
                        <StackPanel>
                            <TextBlock Text="人工检测查询/命令边界不可用" Foreground="#75531A"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="UnavailableText" TextWrapping="Wrap" Foreground="#75531A"
                                       Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="ConfiguredPanel" Visibility="Collapsed">
                    <Border Background="#F8FAFC" BorderBrush="#DAE1E8" BorderThickness="1"
                            Padding="12" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="Runtime 状态" Foreground="#172B42" FontSize="14"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="StatusText" Text="等待刷新" Foreground="#334E68"
                                       TextWrapping="Wrap" Margin="0,6,0,0" />
                            <TextBlock Text="{Binding PhaseSummary}" Foreground="#556679"
                                       TextWrapping="Wrap" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding RestorationSummary}" Foreground="#556679"
                                       TextWrapping="Wrap" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding LastCommandSummary}" Foreground="#556679"
                                       TextWrapping="Wrap" Margin="0,4,0,0" />
                            <TextBlock x:Name="ErrorText" Foreground="#9B3430" TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Background="#F8FAFC" BorderBrush="#DAE1E8" BorderThickness="1"
                            Padding="12" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="精确选择检测来源" Foreground="#172B42" FontSize="14"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="来源列表只显示只读历史中的完整身份；选择不会启动检测。开始命令会把所选 Draft 或 Released 身份原样交给 Runtime。"
                                       Foreground="#6B7888" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Draft 修订" Foreground="#556679" VerticalAlignment="Center" Margin="0,3" />
                                <ComboBox x:Name="DraftComboBox" Grid.Column="1"
                                          ItemsSource="{Binding DraftOptions}"
                                          SelectedItem="{Binding SelectedDraftOption, Mode=TwoWay}"
                                          DisplayMemberPath="Label" Margin="0,3"
                                          AutomationProperties.Name="人工检测 Draft 来源" />
                                <TextBlock Grid.Row="1" Text="Released 版本" Foreground="#556679" VerticalAlignment="Center" Margin="0,3" />
                                <ComboBox x:Name="ReleasedComboBox" Grid.Row="1" Grid.Column="1"
                                          ItemsSource="{Binding ReleasedOptions}"
                                          SelectedItem="{Binding SelectedReleasedOption, Mode=TwoWay}"
                                          DisplayMemberPath="Label" Margin="0,3"
                                          AutomationProperties.Name="人工检测 Released 来源" />
                                <TextBlock Grid.Row="2" Text="当前选择" Foreground="#556679" VerticalAlignment="Center" Margin="0,3" />
                                <TextBlock x:Name="SelectionText" Grid.Row="2" Grid.Column="1"
                                           Text="{Binding SelectionSummary}" Foreground="#172B42"
                                           TextWrapping="Wrap" Margin="0,3" />
                                <TextBlock Grid.Row="3" Text="当前 Active" Foreground="#556679" VerticalAlignment="Center" Margin="0,3" />
                                <TextBlock x:Name="CurrentActiveText" Grid.Row="3" Grid.Column="1"
                                           Text="{Binding CurrentActiveSummary}" Foreground="#334E68"
                                           TextWrapping="Wrap" Margin="0,3" />
                                <TextBlock Grid.Row="4" Text="ExpectedActive" Foreground="#556679" VerticalAlignment="Center" Margin="0,3" />
                                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock x:Name="ExpectedActiveText" Text="{Binding ExpectedActiveSummary}"
                                               Foreground="#334E68" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    <Button x:Name="UseActiveButton" Content="使用当前 Active"
                                            Click="UseActiveClick" Padding="8,3" Margin="10,0,0,0"
                                            AutomationProperties.Name="将当前 Active 设置为 ExpectedActive" />
                                    <Button x:Name="ClearActiveButton" Content="清除"
                                            Click="ClearActiveClick" Padding="8,3" Margin="5,0,0,0"
                                            AutomationProperties.Name="清除 ExpectedActive" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Background="#F8FAFC" BorderBrush="#DAE1E8" BorderThickness="1"
                            Padding="12" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="人工检测历史（只读）" Foreground="#172B42" FontSize="14"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="历史行只展示 Runtime 已记录的阶段、运行状态、决定、理由、主体和精确来源；选中历史不会重新执行检测，也不会形成授权。"
                                       Foreground="#6B7888" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,8" />
                            <WrapPanel>
                                <Button x:Name="RefreshHistoryButton" Content="刷新历史"
                                        Command="{Binding RefreshHistoryCommand}" Padding="10,4"
                                        AutomationProperties.Name="刷新人工检测历史" />
                                <Button x:Name="NextHistoryPageButton" Content="下一页"
                                        Command="{Binding NextHistoryPageCommand}" Padding="10,4" Margin="8,0,0,0"
                                        AutomationProperties.Name="读取下一页人工检测历史" />
                                <TextBlock Text="第" Foreground="#556679" VerticalAlignment="Center" Margin="12,0,3,0" />
                                <TextBlock Text="{Binding HistoryPageNumber}" Foreground="#334E68"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="页" Foreground="#556679" VerticalAlignment="Center" Margin="3,0,0,0" />
                            </WrapPanel>
                            <TextBlock Text="{Binding HistoryStatusMessage}" Foreground="#556679"
                                       TextWrapping="Wrap" Margin="0,7,0,0" />
                            <TextBlock Text="{Binding HistoryErrorCode}" Foreground="#9B3430"
                                       TextWrapping="Wrap" Margin="0,3,0,0" />
                            <DataGrid x:Name="HistoryGrid" ItemsSource="{Binding HistoryRows}"
                                      SelectedItem="{Binding SelectedHistoryRow, Mode=TwoWay}"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      CanUserAddRows="False" CanUserDeleteRows="False"
                                      HeadersVisibility="Column" MaxHeight="240" Margin="0,8,0,0"
                                      AutomationProperties.Name="人工检测历史列表">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="位置" Binding="{Binding Position}" Width="60" />
                                    <DataGridTextColumn Header="状态/阶段" Binding="{Binding StatusSummary}" Width="120" />
                                    <DataGridTextColumn Header="决定" Binding="{Binding DecisionSummary}" Width="90" />
                                    <DataGridTextColumn Header="理由" Binding="{Binding ReasonCode}" Width="180" />
                                    <DataGridTextColumn Header="主体" Binding="{Binding ActorSummary}" Width="230" />
                                    <DataGridTextColumn Header="来源" Binding="{Binding SourceSummary}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <Border Background="White" BorderBrush="#DAE1E8" BorderThickness="1"
                                    Padding="8" Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock Text="选中历史详情" Foreground="#172B42" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding SelectedHistoryRow.DisplaySummary, TargetNullValue=未选择历史行}"
                                               Foreground="#334E68" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding SelectedHistoryRow.ActorSummary, TargetNullValue=未选择历史行}"
                                               Foreground="#556679" TextWrapping="Wrap" Margin="0,3,0,0" />
                                    <TextBlock Text="{Binding SelectedHistoryRow.SourceSummary, TargetNullValue=未选择历史行}"
                                               Foreground="#556679" TextWrapping="Wrap" Margin="0,3,0,0" />
                                    <TextBlock Text="{Binding SelectedHistoryRow.ResultSummary, TargetNullValue=未选择历史行}"
                                               Foreground="#556679" TextWrapping="Wrap" Margin="0,3,0,0" />
                                    <TextBlock Text="{Binding SelectedHistoryRow.OverlaySummary, TargetNullValue=未选择历史行}"
                                               Foreground="#556679" TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Background="#F8FAFC" BorderBrush="#DAE1E8" BorderThickness="1"
                            Padding="12" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="显式人工检测命令" Foreground="#172B42" FontSize="14"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Start 只创建 Runtime 会话；RunOne 由 Runtime 分配本次运行编号；GracefulExit 和 Abort 都是显式会话命令。页面取消只取消等待中的 UI 工作，不取消已交给 Runtime 的检测。"
                                       Foreground="#6B7888" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,8" />
                            <WrapPanel>
                                <Button x:Name="RefreshButton" Content="刷新状态/来源" Click="RefreshClick"
                                        Padding="10,4" AutomationProperties.Name="刷新人工检测状态和来源" />
                                <Button x:Name="StartButton" Content="开始会话" Click="StartClick"
                                        Padding="10,4" Margin="8,0,0,0"
                                        AutomationProperties.Name="开始人工检测会话" />
                                <Button x:Name="RunButton" Content="执行一次" Click="RunClick"
                                        Padding="10,4" Margin="8,0,0,0"
                                        AutomationProperties.Name="执行一次人工检测" />
                                <Button x:Name="GracefulExitButton" Content="正常退出" Click="GracefulExitClick"
                                        Padding="10,4" Margin="8,0,0,0"
                                        AutomationProperties.Name="正常退出人工检测会话" />
                                <Button x:Name="AbortButton" Content="中止并退出" Click="AbortClick"
                                        Padding="10,4" Margin="8,0,0,0"
                                        AutomationProperties.Name="中止并退出人工检测会话" />
                                <Button x:Name="CancelButton" Content="取消页面请求" Click="CancelClick"
                                        Padding="10,4" Margin="8,0,0,0"
                                        AutomationProperties.Name="取消当前人工检测页面请求" />
                            </WrapPanel>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="开始理由" Foreground="#556679" VerticalAlignment="Center" Margin="0,3" />
                                <TextBox x:Name="StartReasonBox" Grid.Column="1"
                                         Text="{Binding StartReason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="256" Margin="0,3" AutomationProperties.Name="开始人工检测理由" />
                                <TextBlock Grid.Row="1" Text="单次检测理由" Foreground="#556679" VerticalAlignment="Center" Margin="0,3" />
                                <TextBox x:Name="RunReasonBox" Grid.Row="1" Grid.Column="1"
                                         Text="{Binding RunReason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="256" Margin="0,3" AutomationProperties.Name="单次人工检测理由" />
                                <TextBlock Grid.Row="2" Text="部件标识（可选）" Foreground="#556679" VerticalAlignment="Center" Margin="0,3" />
                                <TextBox x:Name="PartIdentityBox" Grid.Row="2" Grid.Column="1"
                                         Text="{Binding PartIdentityText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="256" Margin="0,3" AutomationProperties.Name="人工检测部件标识" />
                            </Grid>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="退出理由" Foreground="#556679" VerticalAlignment="Center" Margin="0,3" />
                                <TextBox x:Name="ExitReasonBox" Grid.Column="1"
                                         Text="{Binding ExitReason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="256" Margin="0,3" AutomationProperties.Name="退出人工检测理由" />
                                <TextBlock Grid.Row="1" Text="Step-Up 密码" Foreground="#556679"
                                           VerticalAlignment="Center" Margin="0,3" />
                                <PasswordBox x:Name="StepUpPasswordBox" Grid.Row="1" Grid.Column="1"
                                             MaxLength="256" Margin="0,3"
                                             AutomationProperties.Name="人工检测 Step-Up 密码（需要时输入）" />
                            </Grid>
                            <TextBlock Text="只有 Runtime 返回 RequiresStepUp 时才使用此输入；密码只在提交期间传递给 Step-Up 服务，页面不会保存。"
                                       Foreground="#6B7888" FontSize="11" TextWrapping="Wrap" Margin="100,4,0,0" />
                            <TextBlock Text="{Binding LastCommandSummary}" Foreground="#556679"
                                       TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
