<UserControl x:Class="SharpInspect.Wpf.TraceStoragePolicyPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI">
    <Border Background="White" BorderBrush="#DAE1E8" BorderThickness="1" Padding="18">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid>
                    <StackPanel>
                        <TextBlock Text="追溯存储政策" FontSize="18" FontWeight="SemiBold" Foreground="#172B42" />
                        <TextBlock Text="政策是冻结的存储治理规则；发布不会创建生产运行、InspectionId 或证据义务。"
                                   Foreground="#6B7888" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                    <TextBlock x:Name="StatusLabel" HorizontalAlignment="Right" VerticalAlignment="Top"
                               Foreground="#75531A" Text="未刷新" />
                </Grid>

                <Border Background="#F8FAFC" BorderBrush="#DAE1E8" BorderThickness="1"
                        Padding="12" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="政策身份与审批" FontSize="14" FontWeight="SemiBold" Foreground="#172B42" />
                        <TextBlock Text="审批引用与版本是审批记录元数据；本地人员、权限和新鲜 Step-Up 会绑定完整 Policy.ContentHash。"
                                   Foreground="#6B7888" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Text="PolicyId" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" />
                            <TextBox Text="{Binding Editor.PolicyId, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1" Margin="4" />
                            <TextBlock Text="版本" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" />
                            <TextBox Text="{Binding Editor.Version, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="3" Margin="4" />
                            <TextBlock Text="审批引用" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" />
                            <TextBox Text="{Binding Editor.ApprovalReference, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="1" Margin="4" />
                            <TextBlock Text="审批版本" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" />
                            <TextBox Text="{Binding Editor.ApprovalVersion, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="3" Margin="4" />
                            <TextBlock Text="理由" Grid.Row="2" Grid.Column="0" VerticalAlignment="Top" />
                            <TextBox Text="{Binding Editor.Rationale, UpdateSourceTrigger=PropertyChanged}" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3"
                                     Margin="4" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="#F8FAFC" BorderBrush="#DAE1E8" BorderThickness="1" Padding="12" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="11 类保留规则（每类必须显式填写）" FontSize="14" FontWeight="SemiBold" Foreground="#172B42" />
                        <DataGrid ItemsSource="{Binding Editor.RetentionRules}" AutoGenerateColumns="False" IsReadOnly="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" Margin="0,8,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="证据类别" Binding="{Binding EvidenceClass}" IsReadOnly="True" Width="220" />
                                <DataGridTextColumn Header="起算事件（枚举名）" Binding="{Binding StartsAtText, UpdateSourceTrigger=PropertyChanged}" Width="240" />
                                <DataGridTextColumn Header="最短保留（TimeSpan）" Binding="{Binding MinimumRetention, UpdateSourceTrigger=PropertyChanged}" Width="220" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Background="#F8FAFC" BorderBrush="#DAE1E8" BorderThickness="1" Padding="12" Margin="0,12,0,0">
                    <StackPanel>
                        <DockPanel>
                            <Button x:Name="AddRouteButton" Content="添加路由" DockPanel.Dock="Right" Click="AddRouteClicked" Padding="10,3" />
                            <TextBlock Text="必需路由与限额" FontSize="14" FontWeight="SemiBold" Foreground="#172B42" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="路由可以为空；空集合表示当前部署没有外部追溯路由。" Foreground="#6B7888" FontSize="11" Margin="0,4,0,8" />
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" /><ColumnDefinition Width="95" /><ColumnDefinition Width="260" />
                                <ColumnDefinition Width="95" /><ColumnDefinition Width="110" /><ColumnDefinition Width="130" />
                                <ColumnDefinition Width="90" /><ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="路由 ID" Grid.Column="0" Foreground="#6B7888" />
                            <TextBlock Text="契约版本" Grid.Column="1" Foreground="#6B7888" />
                            <TextBlock Text="契约哈希" Grid.Column="2" Foreground="#6B7888" />
                            <TextBlock Text="最大条数" Grid.Column="3" Foreground="#6B7888" />
                            <TextBlock Text="最大字节" Grid.Column="4" Foreground="#6B7888" />
                            <TextBlock Text="最老时长" Grid.Column="5" Foreground="#6B7888" />
                            <TextBlock Text="类型" Grid.Column="6" Foreground="#6B7888" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Editor.RequiredRoutes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#E4EAF0" BorderThickness="0,0,0,1" Padding="0,5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="95" />
                                                <ColumnDefinition Width="260" />
                                                <ColumnDefinition Width="95" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="70" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding RouteId, UpdateSourceTrigger=PropertyChanged}" Grid.Column="0" Margin="2" ToolTip="RouteId" />
                                            <TextBox Text="{Binding ContractVersion, UpdateSourceTrigger=PropertyChanged}" Grid.Column="1" Margin="2" ToolTip="ContractVersion" />
                                            <TextBox Text="{Binding ContractHash, UpdateSourceTrigger=PropertyChanged}" Grid.Column="2" Margin="2" ToolTip="ContractHash" />
                                            <TextBox Text="{Binding Limits.MaximumItems, UpdateSourceTrigger=PropertyChanged}" Grid.Column="3" Margin="2" ToolTip="MaximumItems" />
                                            <TextBox Text="{Binding Limits.MaximumBytes, UpdateSourceTrigger=PropertyChanged}" Grid.Column="4" Margin="2" ToolTip="MaximumBytes" />
                                            <TextBox Text="{Binding Limits.MaximumOldestAge, UpdateSourceTrigger=PropertyChanged}" Grid.Column="5" Margin="2" ToolTip="MaximumOldestAge" />
                                            <TextBlock Text="路由" Grid.Column="6" VerticalAlignment="Center" Foreground="#6B7888" />
                                            <Button Content="删除" Grid.Column="7" Tag="{Binding}" Click="RemoveRouteClicked" Padding="5,2" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Background="#F8FAFC" BorderBrush="#DAE1E8" BorderThickness="1" Padding="12" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="存储容量、超时与维护预算" FontSize="14" FontWeight="SemiBold" Foreground="#172B42" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="175" />
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="175" />
                                <ColumnDefinition Width="190" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Text="最小保留字节" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" />
                            <TextBox Text="{Binding Editor.MinimumReserveBytes, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1" Margin="4" />
                            <TextBlock Text="最小保留百分比" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" />
                            <TextBox Text="{Binding Editor.MinimumReservePercent, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="3" Margin="4" />
                            <TextBlock Text="EvidenceStageTimeout" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" />
                            <TextBox Text="{Binding Editor.EvidenceStageTimeout, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="1" Margin="4" />
                            <TextBlock Text="TraceCommitTimeout" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" />
                            <TextBox Text="{Binding Editor.TraceCommitTimeout, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="3" Margin="4" />
                            <TextBlock Text="最大 WAL 字节" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" />
                            <TextBox Text="{Binding Editor.MaximumWalBytes, UpdateSourceTrigger=PropertyChanged}" Grid.Row="2" Grid.Column="1" Margin="4" />
                            <TextBlock Text="ImageBacklog 最大条数" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" />
                            <TextBox Text="{Binding Editor.ImageBacklog.MaximumItems, UpdateSourceTrigger=PropertyChanged}" Grid.Row="3" Grid.Column="1" Margin="4" />
                            <TextBlock Text="ImageBacklog 最大字节" Grid.Row="3" Grid.Column="2" VerticalAlignment="Center" />
                            <TextBox Text="{Binding Editor.ImageBacklog.MaximumBytes, UpdateSourceTrigger=PropertyChanged}" Grid.Row="3" Grid.Column="3" Margin="4" />
                            <TextBlock Text="ImageBacklog 最老时长" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" />
                            <TextBox Text="{Binding Editor.ImageBacklog.MaximumOldestAge, UpdateSourceTrigger=PropertyChanged}" Grid.Row="4" Grid.Column="1" Margin="4" />
                        </Grid>
                        <TextBlock Text="Scrubber" FontWeight="SemiBold" Margin="0,10,0,2" />
                        <UniformGrid Columns="4">
                            <TextBlock Text="间隔" Foreground="#6B7888" Margin="2" />
                            <TextBlock Text="最长运行" Foreground="#6B7888" Margin="2" />
                            <TextBlock Text="最大字节" Foreground="#6B7888" Margin="2" />
                            <TextBlock Text="最大条数" Foreground="#6B7888" Margin="2" />
                        </UniformGrid>
                        <UniformGrid Columns="4">
                            <TextBox Text="{Binding Editor.Scrubber.Interval, UpdateSourceTrigger=PropertyChanged}" ToolTip="Interval" Margin="2" />
                            <TextBox Text="{Binding Editor.Scrubber.MaximumRunTime, UpdateSourceTrigger=PropertyChanged}" ToolTip="MaximumRunTime" Margin="2" />
                            <TextBox Text="{Binding Editor.Scrubber.MaximumBytes, UpdateSourceTrigger=PropertyChanged}" ToolTip="MaximumBytes" Margin="2" />
                            <TextBox Text="{Binding Editor.Scrubber.MaximumItems, UpdateSourceTrigger=PropertyChanged}" ToolTip="MaximumItems" Margin="2" />
                        </UniformGrid>
                        <TextBlock Text="Checkpoint" FontWeight="SemiBold" Margin="0,8,0,2" />
                        <UniformGrid Columns="4">
                            <TextBlock Text="间隔" Foreground="#6B7888" Margin="2" />
                            <TextBlock Text="最长运行" Foreground="#6B7888" Margin="2" />
                            <TextBlock Text="最大字节" Foreground="#6B7888" Margin="2" />
                            <TextBlock Text="最大条数" Foreground="#6B7888" Margin="2" />
                        </UniformGrid>
                        <UniformGrid Columns="4">
                            <TextBox Text="{Binding Editor.Checkpoint.Interval, UpdateSourceTrigger=PropertyChanged}" ToolTip="Interval" Margin="2" />
                            <TextBox Text="{Binding Editor.Checkpoint.MaximumRunTime, UpdateSourceTrigger=PropertyChanged}" ToolTip="MaximumRunTime" Margin="2" />
                            <TextBox Text="{Binding Editor.Checkpoint.MaximumBytes, UpdateSourceTrigger=PropertyChanged}" ToolTip="MaximumBytes" Margin="2" />
                            <TextBox Text="{Binding Editor.Checkpoint.MaximumItems, UpdateSourceTrigger=PropertyChanged}" ToolTip="MaximumItems" Margin="2" />
                        </UniformGrid>
                        <TextBlock Text="维护预算顺序：Interval · MaximumRunTime · MaximumBytes · MaximumItems。所有字段均要求显式输入。"
                                   Foreground="#6B7888" FontSize="11" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border Background="#FFF7E7" BorderBrush="#E4CE9F" BorderThickness="1" Padding="12" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="验证结果" FontWeight="SemiBold" Foreground="#75531A" />
                        <ItemsControl ItemsSource="{Binding ValidationErrors}" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding ErrorCode}" Foreground="#9B3430" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding StatusMessage}" Foreground="#334E68" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" /><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /><ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="发布原因" Grid.Column="0" VerticalAlignment="Center" />
                    <TextBox x:Name="ReasonTextBox" Grid.Column="1" MaxLength="512" Margin="4" />
                    <TextBlock Text="当前人员 Step-Up" Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0" />
                    <PasswordBox x:Name="StepUpPasswordBox" Grid.Column="3" MaxLength="256" Margin="4" />
                </Grid>
                <WrapPanel Margin="0,4,0,0">
                    <Button x:Name="RefreshButton" Content="刷新" Click="RefreshClicked" Padding="12,5" Margin="0,0,8,0" />
                    <Button x:Name="LoadCurrentButton" Content="加载当前到编辑器" Click="LoadCurrentClicked" Padding="12,5" Margin="0,0,8,0" />
                    <Button x:Name="PublishButton" Content="发布政策" Click="PublishClicked" Padding="12,5" />
                </WrapPanel>

                <Border Background="#F8FAFC" BorderBrush="#DAE1E8" BorderThickness="1" Padding="12" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="当前只读投影" FontWeight="SemiBold" Foreground="#172B42" />
                        <TextBlock Text="{Binding Current.ContentHash, TargetNullValue=尚未发布}" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding Snapshot.ContentHash, TargetNullValue=尚未生成快照}" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding Preflight.ContentHash, TargetNullValue=尚未读取预检}" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <DataGrid ItemsSource="{Binding History.Records}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="220" Margin="0,8,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="版本" Binding="{Binding Version}" Width="60" />
                                <DataGridTextColumn Header="发布时间" Binding="{Binding PublishedAtUtc}" Width="180" />
                                <DataGridTextColumn Header="政策哈希" Binding="{Binding Policy.ContentHash}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <DataGrid ItemsSource="{Binding Preflight.Rows}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="220" Margin="0,8,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="预检门" Binding="{Binding Gate}" Width="180" />
                                <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="120" />
                                <DataGridTextColumn Header="原因" Binding="{Binding ReasonCode}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
