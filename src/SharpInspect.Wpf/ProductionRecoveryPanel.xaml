<UserControl x:Class="SharpInspect.Wpf.ProductionRecoveryPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:abs="clr-namespace:SharpInspect.Abstractions;assembly=SharpInspect.Abstractions">
    <Border Background="White" BorderBrush="#DAE1E8" BorderThickness="1" Padding="16">
        <StackPanel>
            <TextBlock Text="生产恢复维护" FontSize="18" FontWeight="SemiBold" Foreground="#172B42" />
            <TextBlock Text="请核对未完成的交付记录及实物处置。恢复前将验证设备已安全停线、操作权限和重新认证，并保存审计记录。"
                       TextWrapping="Wrap" Foreground="#6B7888" Margin="0,6,0,12" />
            <TextBlock x:Name="UnavailableText" Text="生产恢复不可用：请先登录并配置查询与 Runtime。"
                       Foreground="#75531A" TextWrapping="Wrap" Visibility="Collapsed" />
            <StackPanel x:Name="ConfiguredPanel">
                <TextBlock Text="待恢复事实" FontWeight="SemiBold" />
                <TextBlock Text="{Binding FreshnessLabel}" Foreground="#75531A" Margin="0,4,0,2" />
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="#334E68" Margin="0,0,0,4" />
                <TextBlock Text="{Binding ErrorCode}" TextWrapping="Wrap" Foreground="#9B3430" Margin="0,0,0,8" />
                <DataGrid x:Name="PendingGrid" ItemsSource="{Binding Pending}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                          Height="190" HeadersVisibility="Column" SelectionMode="Single" Margin="0,0,0,10">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="位置" Binding="{Binding Position}" Width="58" />
                        <DataGridTextColumn Header="Inspection" Binding="{Binding InspectionId}" Width="230" />
                        <DataGridTextColumn Header="最后阶段" Binding="{Binding DeliveryPhase}" Width="130" />
                        <DataGridTextColumn Header="不确定性" Binding="{Binding Uncertainty}" Width="145" />
                        <DataGridTextColumn Header="事件哈希" Binding="{Binding EventHash}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>

                <Border Background="#F8FAFC" BorderBrush="#DAE1E8" BorderThickness="1" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="选中记录详情" FontWeight="SemiBold" Foreground="#172B42" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="155" /><ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                <RowDefinition />
                                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Runtime Epoch" Foreground="#556679" />
                            <TextBlock Grid.Column="1" Text="{Binding SelectedRuntimeEpoch}" FontFamily="Consolas" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="1" Text="Controller / Cycle" Foreground="#556679" />
                            <TextBlock Grid.Row="1" Grid.Column="1">
                                <Run Text="{Binding SelectedControllerEpoch, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding SelectedCycleSequence, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Grid.Row="2" Text="最后持久阶段" Foreground="#556679" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedDeliveryPhase}" />
                            <TextBlock Grid.Row="3" Text="交付不确定性" Foreground="#556679" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedUncertainty}" />
                            <TextBlock Grid.Row="4" Text="Core 合同哈希" Foreground="#556679" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedCoreContentHash}" FontFamily="Consolas" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="5" Text="Payload 合同" Foreground="#556679" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedPayloadContractVersion}" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="6" Text="Payload 哈希" Foreground="#556679" />
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SelectedPayloadContentHash}" FontFamily="Consolas" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="7" Text="Wire 哈希" Foreground="#556679" />
                            <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding SelectedPayloadWireContentHash}" FontFamily="Consolas" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="8" Text="Payload 合同哈希" Foreground="#556679" />
                            <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding SelectedPayloadContractHash}" FontFamily="Consolas" TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="处置原因" FontWeight="SemiBold" />
                <TextBox x:Name="ReasonTextBox" Text="{Binding ReasonText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="256" Margin="0,4,0,8" />
                <TextBlock Text="处置决定" FontWeight="SemiBold" />
                <ComboBox x:Name="DispositionComboBox" SelectedValue="{Binding SelectedDisposition, Mode=TwoWay}"
                          SelectedValuePath="Tag" Margin="0,4,0,8">
                    <ComboBoxItem Content="隔离" Tag="{x:Static abs:PartDisposition.Isolated}" />
                    <ComboBoxItem Content="返工" Tag="{x:Static abs:PartDisposition.Reworked}" />
                    <ComboBoxItem Content="报废" Tag="{x:Static abs:PartDisposition.Scrapped}" />
                    <ComboBoxItem Content="人工接受" Tag="{x:Static abs:PartDisposition.ManuallyAccepted}" />
                </ComboBox>
                <TextBlock Text="处置备注（可选）" FontWeight="SemiBold" />
                <TextBox x:Name="DispositionNoteTextBox"
                         Text="{Binding DispositionNote, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="512" TextWrapping="Wrap" Height="58" Margin="0,4,0,8" />
                <TextBlock Text="重新输入密码以确认本次恢复" FontWeight="SemiBold" />
                <PasswordBox x:Name="StepUpPasswordBox" MaxLength="256" Margin="0,4,0,8" />
                <WrapPanel>
                    <Button x:Name="RefreshButton" Content="刷新待恢复" Click="RefreshClick" Padding="12,5" Margin="0,0,8,0" />
                    <Button x:Name="RecoverButton" Content="提交恢复处置" Click="RecoverClick" Padding="12,5" />
                </WrapPanel>
                <TextBlock Text="记录陈旧或登录状态变化时，需要刷新并重新认证后才能提交。恢复完成后仍需另行武装生产。"
                           Foreground="#75531A" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
