<UserControl x:Class="SharpInspect.Wpf.ProductionImageEvidencePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="White" BorderBrush="#DAE1E8" BorderThickness="1" Padding="18">
        <StackPanel>
            <TextBlock Text="生产原图证据" Foreground="#172B42" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="查看原图的持久状态、生成尝试和规范像素哈希。" Foreground="#556679" Margin="0,6,0,12" />
            <WrapPanel>
                <TextBlock Text="检测 ID" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Text="{Binding InspectionText, UpdateSourceTrigger=PropertyChanged}" MaxLength="64"
                         Width="290" Margin="0,0,8,0" />
                <Button Content="刷新证据" Command="{Binding RefreshCommand}" Padding="12,6" Margin="0,0,8,0" />
                <Button Content="下一页" Command="{Binding NextPageCommand}" Padding="12,6" />
            </WrapPanel>
            <TextBlock Text="{Binding StatusMessage}" Foreground="#556679" TextWrapping="Wrap" Margin="0,10" />
            <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRecord, Mode=TwoWay}"
                      IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      SelectionMode="Single" MinHeight="80" MaxHeight="220" EnableRowVirtualization="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="检测 ID" Binding="{Binding Identity.InspectionId}" Width="*" />
                    <DataGridTextColumn Header="持久状态" Binding="{Binding State.State}" Width="100" />
                    <DataGridTextColumn Header="尝试次数" Binding="{Binding State.AttemptCount}" Width="85" />
                    <DataGridTextColumn Header="最近失败原因" Binding="{Binding State.LastFailureReasonCode}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="{Binding SelectionSummary}" Foreground="#334E68" TextWrapping="Wrap" Margin="0,12,0,6" />
            <TextBlock Text="{Binding FinalFileSummary}" Foreground="#556679" TextWrapping="Wrap" Margin="0,0,0,6" />
            <TextBlock Text="规范像素 SHA-256" FontWeight="SemiBold" />
            <TextBox Text="{Binding ContentHash, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" TextWrapping="Wrap"
                     Foreground="#334E68" Margin="0,4,0,12" />
            <DataGrid ItemsSource="{Binding SelectedEvents}" IsReadOnly="True" AutoGenerateColumns="False"
                      CanUserAddRows="False" CanUserDeleteRows="False" MinHeight="60" MaxHeight="180"
                      EnableRowVirtualization="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="时间" Binding="{Binding RecordedAtUtc}" Width="*" />
                    <DataGridTextColumn Header="生命周期" Binding="{Binding Kind}" Width="120" />
                    <DataGridTextColumn Header="原因" Binding="{Binding ReasonCode}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </Border>
</UserControl>
