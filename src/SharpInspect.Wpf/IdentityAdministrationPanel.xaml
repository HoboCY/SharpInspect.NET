<UserControl x:Class="SharpInspect.Wpf.IdentityAdministrationPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="560">
    <Border Background="White" BorderBrush="#DAE1E8" BorderThickness="1" Padding="18">
        <ScrollViewer x:Name="AdministrationScrollViewer" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="身份管理 · 个人目录与授权变更" Foreground="#172B42" FontSize="16" FontWeight="SemiBold" />
        <TextBlock Text="管理操作需要输入当前密码再次确认。结果以刷新后的个人目录为准。"
                   Foreground="#6B7888" FontSize="11" Margin="0,6,0,12" TextWrapping="Wrap" />

                <StackPanel x:Name="UnavailablePanel" Background="#FFF7E7" Margin="0,0,0,12" Visibility="Visible">
                    <TextBlock Text="身份管理不可用：请确认当前登录状态和管理服务配置。"
                               Foreground="#75531A" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel x:Name="ConfiguredPanel" Visibility="Collapsed">
                    <WrapPanel Margin="0,0,0,6">
                        <TextBlock Text="当前状态：" Foreground="#556679" />
                        <TextBlock x:Name="StatusLabel" Text="" Foreground="#334E68" />
                        <Button Content="刷新权限与目录" Click="RefreshClick" Margin="18,0,0,0" />
                    </WrapPanel>
                    <TextBlock x:Name="StatusMessage" Foreground="#334E68" TextWrapping="Wrap" />
                    <TextBlock x:Name="ErrorLabel" Foreground="#9B3430" Margin="0,4,0,10" TextWrapping="Wrap" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="1.3*" />
                        </Grid.ColumnDefinitions>

                        <Border Background="#F8FAFC" BorderBrush="#DAE1E8" BorderThickness="1" Padding="12">
                            <StackPanel>
                                <TextBlock Text="个人目录" Foreground="#172B42" FontSize="14" FontWeight="SemiBold" />
                                <ListBox x:Name="AccountListBox" ItemsSource="{Binding Accounts}"
                                         SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
                                         DisplayMemberPath="DisplayName" Height="230" Margin="0,8,0,0" />
                                <TextBlock Text="选择人员后可进行禁用、解锁、重绑和权限变更。"
                                           Foreground="#6B7888" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Column="2">
                            <Border Background="#F8FAFC" BorderBrush="#DAE1E8" BorderThickness="1" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="创建个人账号" Foreground="#172B42" FontSize="14" FontWeight="SemiBold" />
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="用户名" Foreground="#556679" Margin="0,0,6,7" />
                                        <TextBox x:Name="CreateUserNameBox" Grid.Column="1" Margin="0,0,0,7" />
                                        <TextBlock Text="显示名" Grid.Row="1" Foreground="#556679" Margin="0,0,6,7" />
                                        <TextBox x:Name="CreateDisplayNameBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,7" />
                                        <TextBlock Text="新密码" Grid.Row="2" Foreground="#556679" Margin="0,0,6,7" />
                                        <PasswordBox x:Name="CreatePasswordBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,7" />
                                        <TextBlock Text="角色包" Grid.Row="3" Foreground="#556679" Margin="0,0,6,7" />
                                        <ComboBox x:Name="RoleComboBox" Grid.Row="3" Grid.Column="1" ItemsSource="{Binding RoleOptions}"
                                                  SelectedItem="{Binding SelectedRoleBundle, Mode=TwoWay}" Margin="0,0,0,7" />
                                        <TextBlock Text="当前密码" Grid.Row="4" Foreground="#556679" Margin="0,0,6,7" />
                                        <PasswordBox x:Name="CreateStepUpPasswordBox" Grid.Row="4" Grid.Column="1" Margin="0,0,0,7" />
                                    </Grid>
                                    <Button x:Name="CreateButton" Content="创建账号" HorizontalAlignment="Left" Click="CreateClick" />
                                </StackPanel>
                            </Border>

                            <Border Background="#F8FAFC" BorderBrush="#DAE1E8" BorderThickness="1" Padding="12" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="当前人员操作" Foreground="#172B42" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="当前人员重新认证" Foreground="#556679" Margin="0,8,0,3" />
                                    <PasswordBox x:Name="ActionStepUpPasswordBox" />
                                    <WrapPanel Margin="0,8,0,0">
                                        <Button x:Name="DisableButton" Content="禁用凭据" Click="DisableClick" />
                                        <Button x:Name="UnlockButton" Content="解锁凭据" Click="UnlockClick" />
                                        <Button x:Name="RebindButton" Content="重绑凭据" Click="RebindClick" />
                                    </WrapPanel>
                                    <TextBlock Text="重绑新密码" Foreground="#556679" Margin="0,8,0,3" />
                                    <PasswordBox x:Name="RebindPasswordBox" />
                                    <TextBlock Text="权限选择" Foreground="#556679" Margin="0,8,0,3" />
                                    <ListBox x:Name="PermissionListBox" ItemsSource="{Binding PermissionOptions}"
                                             SelectionMode="Extended" Height="145" />
                                    <Button x:Name="SetPermissionsButton" Content="提交权限变更" HorizontalAlignment="Left"
                                            Margin="0,8,0,0" Click="SetPermissionsClick" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
