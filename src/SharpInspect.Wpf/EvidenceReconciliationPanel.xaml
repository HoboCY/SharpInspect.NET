<UserControl x:Class="SharpInspect.Wpf.EvidenceReconciliationPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="White" BorderBrush="#DAE1E8" BorderThickness="1" Padding="18">
        <StackPanel>
            <TextBlock Text="证据核对与历史巡检" Foreground="#172B42" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="查看启动核对、文件隔离和巡检进度。这里的完成状态描述已提交的核对记录，当前生产状态请查看站点准入。" Foreground="#556679" TextWrapping="Wrap" Margin="0,6,0,12" />
            <WrapPanel>
                <Button Content="刷新记录" Command="{Binding RefreshCommand}" Padding="12,6" Margin="0,0,8,0" />
                <Button Content="下一页" Command="{Binding NextPageCommand}" Padding="12,6" />
            </WrapPanel>
            <TextBlock Text="{Binding StatusMessage}" Foreground="#556679" TextWrapping="Wrap" Margin="0,10,0,6" />
            <TextBlock Text="{Binding StartupSummary}" Foreground="#334E68" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ScrubberSummary}" Foreground="#334E68" TextWrapping="Wrap" Margin="0,4" />
            <TextBlock Text="{Binding IntegritySummary}" Foreground="#334E68" TextWrapping="Wrap" Margin="0,0,0,10" />
            <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRecord, Mode=TwoWay}"
                      IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      SelectionMode="Single" MinHeight="80" MaxHeight="220" EnableRowVirtualization="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="序号" Binding="{Binding Position}" Width="65" />
                    <DataGridTextColumn Header="记录时间" Binding="{Binding RecordedAtUtc}" Width="180" />
                    <DataGridTextColumn Header="核对原因" Binding="{Binding ReasonCode}" Width="*" />
                    <DataGridTextColumn Header="检测 ID" Binding="{Binding Subject.InspectionId}" Width="*" />
                    <DataGridTextColumn Header="源文件" Binding="{Binding Subject.SourceFileName}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
            <TextBox Text="{Binding SelectionSummary, Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                     TextWrapping="Wrap" Foreground="#334E68" Margin="0,12,0,0" />
        </StackPanel>
    </Border>
</UserControl>
