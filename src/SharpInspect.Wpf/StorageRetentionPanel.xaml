<UserControl x:Class="SharpInspect.Wpf.StorageRetentionPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI">
    <Border Background="White" BorderBrush="#DAE1E8" BorderThickness="1" Padding="18">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="存储容量与证据保留" Foreground="#172B42" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="查看存储容量、已批准的保留策略与证据记录。登记、释放或延长人工保留时，需要使用当前个人账号再次验证身份。"
                           Foreground="#556679" TextWrapping="Wrap" Margin="0,6,0,12" />
                <WrapPanel>
                    <Button x:Name="RefreshButton" Content="刷新" Command="{Binding RefreshCommand}"
                            Padding="12,6" Margin="0,0,8,0" />
                    <Button x:Name="NextPageButton" Content="下一页" Command="{Binding NextPageCommand}" Padding="12,6" />
                </WrapPanel>
                <TextBlock Text="{Binding StatusText}" Foreground="#556679" TextWrapping="Wrap" Margin="0,10,0,6" />

                <TextBlock Text="容量观察" FontWeight="SemiBold" Foreground="#172B42" Margin="0,4,0,2" />
                <TextBox Text="{Binding CapacityText, Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                         TextWrapping="Wrap" Foreground="#334E68" Background="Transparent" />

                <TextBlock Text="保留执行策略与账本统计" FontWeight="SemiBold" Foreground="#172B42" Margin="0,10,0,2" />
                <TextBox Text="{Binding PolicyText, Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                         TextWrapping="Wrap" Foreground="#334E68" Background="Transparent" />

                <TextBlock Text="证据主体（保留状态）" FontWeight="SemiBold" Foreground="#172B42" Margin="0,12,0,4" />
                <DataGrid ItemsSource="{Binding Subjects}" SelectedItem="{Binding SelectedSubject, Mode=TwoWay}"
                          IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          SelectionMode="Single" MinHeight="80" MaxHeight="200" EnableRowVirtualization="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="主体类型" Binding="{Binding Obligation.Owner.Kind}" Width="90" />
                        <DataGridTextColumn Header="主体 ID" Binding="{Binding Obligation.Owner.OwnerId}" Width="*" />
                        <DataGridTextColumn Header="处置状态" Binding="{Binding Disposition}" Width="90" />
                        <DataGridTextColumn Header="修订" Binding="{Binding Revision}" Width="60" />
                        <DataGridTextColumn Header="生效保留至（UTC）" Binding="{Binding EffectiveUntilUtc}" Width="180" />
                        <DataGridTextColumn Header="人工保留数" Binding="{Binding ActiveHolds.Count}" Width="80" />
                        <DataGridTextColumn Header="删除尝试" Binding="{Binding DeleteAttempts}" Width="70" />
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="{Binding SelectionSummary}" Foreground="#334E68" TextWrapping="Wrap" Margin="0,8,0,4" />

                <TextBlock Text="保留事实历史（当前页）" FontWeight="SemiBold" Foreground="#172B42" Margin="0,8,0,4" />
                <DataGrid ItemsSource="{Binding History}" IsReadOnly="True" AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False" MinHeight="80" MaxHeight="200"
                          EnableRowVirtualization="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="位置" Binding="{Binding Position}" Width="65" />
                        <DataGridTextColumn Header="记录时间（UTC）" Binding="{Binding RecordedAtUtc}" Width="180" />
                        <DataGridTextColumn Header="事件" Binding="{Binding Kind}" Width="120" />
                        <DataGridTextColumn Header="主体类型" Binding="{Binding Owner.Kind}" Width="90" />
                        <DataGridTextColumn Header="人工保留 ID" Binding="{Binding HoldId}" Width="*" />
                        <DataGridTextColumn Header="延至（UTC）" Binding="{Binding ExtendedUntilUtc}" Width="180" />
                        <DataGridTextColumn Header="审计序号" Binding="{Binding AuditSequence}" Width="80" />
                        <DataGridTextColumn Header="原因" Binding="{Binding Reason}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>

                <Expander Header="保留处置（登记 / 释放 / 延长）" Margin="0,12,0,0">
                    <StackPanel Margin="0,10,0,0">
                        <TextBlock Text="请核对所选证据、处置原因与保留期限。验证身份期间修改内容或切换账号，需要重新验证；提交后请核对最新记录。"
                                   TextWrapping="Wrap" Foreground="#556679" Margin="0,0,0,10" />
                        <TextBlock Text="处置原因（最多 512 字符）" FontWeight="SemiBold" />
                        <TextBox x:Name="ReasonTextBox" Text="{Binding ReasonText, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="512" Margin="0,4,0,10" />
                        <WrapPanel Margin="0,0,0,10">
                            <TextBlock Text="释放所选人工保留 ID" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox x:Name="HoldSelector" Width="320" ItemsSource="{Binding SelectedSubject.ActiveHolds}"
                                      SelectedItem="{Binding SelectedHoldId, Mode=TwoWay}" />
                        </WrapPanel>
                        <WrapPanel Margin="0,0,0,10">
                            <TextBlock Text="延长至（UTC，ISO 8601，例如 2031-01-01T00:00:00Z）"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox x:Name="ExtendedUntilTextBox" Width="300" MaxLength="64"
                                     Text="{Binding ExtendedUntilText, UpdateSourceTrigger=PropertyChanged}" />
                        </WrapPanel>
                        <TextBlock Text="当前个人账号密码（再次验证身份）" FontWeight="SemiBold" />
                        <PasswordBox x:Name="StepUpPasswordBox" MaxLength="1024" Margin="0,4,0,10" />
                        <WrapPanel>
                            <Button x:Name="PlaceHoldButton" Content="登记人工保留" IsEnabled="{Binding CanPlaceHold}"
                                    Click="PlaceHoldClick" Padding="12,6" Margin="0,0,8,0" />
                            <Button x:Name="ReleaseHoldButton" Content="释放所选人工保留" IsEnabled="{Binding CanReleaseHold}"
                                    Click="ReleaseHoldClick" Padding="12,6" Margin="0,0,8,0" />
                            <Button x:Name="ExtendButton" Content="延长保留期" IsEnabled="{Binding CanExtend}"
                                    Click="ExtendClick" Padding="12,6" />
                        </WrapPanel>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
