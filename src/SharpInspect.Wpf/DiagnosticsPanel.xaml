<UserControl x:Class="SharpInspect.Wpf.DiagnosticsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="White" BorderBrush="#CCD7E3" BorderThickness="1" CornerRadius="4" Padding="16">
        <StackPanel>
            <TextBlock Text="运行日志与诊断" FontSize="18" FontWeight="SemiBold" Foreground="#172B42" />
            <TextBlock Text="{Binding HealthText}" TextWrapping="Wrap" Margin="0,8,0,4" />
            <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                <CheckBox Content="受保护诊断（需诊断及受保护导出权限）" IsChecked="{Binding ProtectedChannel}" VerticalAlignment="Center" />
                <Button Content="查询" Command="{Binding RefreshCommand}" Padding="16,5" Margin="16,0,0,0" />
            </StackPanel>
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Margin="0,0,0,8" />
            <DataGrid ItemsSource="{Binding Rows}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                CanUserDeleteRows="False" MinHeight="100" MaxHeight="280" EnableRowVirtualization="True" ClipboardCopyMode="None">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="时间（UTC）" Binding="{Binding Time}" Width="165" />
                    <DataGridTextColumn Header="事件" Binding="{Binding Code}" Width="180" />
                    <DataGridTextColumn Header="级别" Binding="{Binding Level}" Width="95" />
                    <DataGridTextColumn Header="执行身份" Binding="{Binding Execution}" Width="220" />
                    <DataGridTextColumn Header="已分类字段" Binding="{Binding Properties}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </Border>
</UserControl>
